// Una época del entrenamiento distribuido (UML 2.5, diagrama de actividades
// con particiones): fan-out de los pesos, cálculo en cada nodo, fan-in y
// reducción en orden de bloque.
// Fuente de docs/informe/tb2/fig/epoca.svg: make figuras.
digraph epoca {
  graph [rankdir=TB, fontname="Liberation Serif", fontsize=11, nodesep=0.35, ranksep=0.4, splines=polyline, pad=0.1, newrank=true]
  node  [shape=box, style=rounded, fontname="Liberation Serif", fontsize=10.5, penwidth=0.9, margin="0.12,0.05", height=0.38]
  edge  [fontname="Liberation Serif", fontsize=9, penwidth=0.8, arrowsize=0.6, arrowhead=vee]

  inicio [shape=circle, style=filled, fillcolor=black, label="", width=0.16, height=0.16, fixedsize=true]
  fin    [shape=doublecircle, style=filled, fillcolor=black, label="", width=0.12, height=0.12, fixedsize=true]
  fork1  [shape=box, style=filled, fillcolor=black, label="", width=2.6, height=0.04, fixedsize=true]
  join1  [shape=box, style=filled, fillcolor=black, label="", width=2.6, height=0.04, fixedsize=true]

  subgraph cluster_coord {
    label="Coordinador (cmd/coordinator)"; labeljust=l; fontsize=10; penwidth=0.7
    pend   [label="Marcar todos los shards\ncomo pendientes"]
    enviar [label="Enviar «epoca» (número, shard, pesos w)\na cada dueño, con un plazo por shard"]
    colocar [label="Colocar cada parcial en el slot\nde su índice global de bloque"]
    reducir [label="Reducir en orden de bloque:\ng = (Σ G_k) / (Σ s_i) + λw"]
    actualizar [label="w ← w − η · g"]
  }
  subgraph cluster_nodo {
    label="Cada nodo (cmd/node), en paralelo"; labeljust=l; fontsize=10; penwidth=0.7
    recibir [label="Recibir «epoca»"]
    pool    [label="Calcular con el worker pool\nun parcial por bloque del shard"]
    responder [label="Enviar «gradiente»\n(sin sumar los parciales)"]
  }

  inicio -> pend -> enviar -> fork1
  fork1 -> recibir [label=" TCP"]
  recibir -> pool -> responder -> join1
  join1 -> colocar [label=" TCP"]
  colocar -> reducir [label=" [llegaron todos\n los shards]"]
  reducir -> actualizar -> fin
}
